# ===========================================================
# KinderEditAI Environment Configuration Template
# Copy this file and rename it to `.env` to configure your local runtime environment.
# ===========================================================

# [Video Processing Settings]
# Defines the runtime environment. 'development' outputs detailed debug logs, 'production' is quiet mode.
PROJECT_ENV=development

# The target frame rate for the final MP4 rendering. It must match the original footage (usually 30 or 60) to prevent stuttering.
DEFAULT_FRAME_RATE=30

# Target resolution for rendering. Recommendation: Use '720p' for prototype testing to save time, and '1080p' for final delivery.
DEFAULT_RESOLUTION=720p

# [Path Configuration]
# Relative or absolute path containing the original multi-camera MP4 files.
# Warning: Before running sync.py, ensure this folder contains at least two valid video files.
INPUT_FOLDER=./starter-pack

# Directory for saving the generated EDL JSON, synchronization offset data, and final rendered video.
# If this folder does not exist, it will be created automatically at runtime.
OUTPUT_FOLDER=./output